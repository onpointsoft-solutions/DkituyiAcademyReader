# Production Environment Variables
# SECURITY WARNING: Use strong, unique secrets in production!

# Django Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=ebooks.dkituyiacademy.org,localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=https://ebooks.dkituyiacademy.org,https://dkituyiacademy.org
CSRF_TRUSTED_ORIGINS=https://ebooks.dkituyiacademy.org,https://dkituyiacademy.org

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600

# Database (PostgreSQL recommended for production)
# DATABASE_URL=postgresql://username:password@hostname:port/database_name

# WordPress Integration
WORDPRESS_URL=https://dkituyiacademy.org
WOOCOMMERCE_API_URL=https://dkituyiacademy.org/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=your-woocommerce-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-woocommerce-consumer-secret

# Paystack Payment Integration
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key
PAYSTACK_CALLBACK_URL=https://ebooks.dkituyiacademy.org/payment/callback
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret-key

# Frontend URL
FRONTEND_URL=https://ebooks.dkituyiacademy.org

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=dkituyi academy <noreply@dkituyiacademy.com>
ADMIN_EMAIL=admin@dkituyiacademy.com

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800

# Payment Settings
PAYMENT_CURRENCY=USD
DEFAULT_BOOK_PRICE=9.99

# Academy Branding
ACADEMY_NAME=dkituyi academy
ACADEMY_TAGLINE=Celebrating Great Literature & Digital Reading
ACADEMY_URL=https://dkituyiacademy.com

# Payment Settings (in KES)
CHAPTER_PRICE=25
SECTION_PRICE=49
BOOK_PRICE_MIN=99
BOOK_PRICE_MAX=149
BOOK_PRICE_DEFAULT=129
SUBSCRIPTION_WEEKLY=99
SUBSCRIPTION_MONTHLY=299
SUBSCRIPTION_PREMIUM=499
